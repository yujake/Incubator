*.docx   binary
*.xlsx   binary
*.pptx   binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.bmp    binary
*.tif    binary
*.tiff   binary
# 字体
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.eot    binary
# 归档 / 安装包 / 可执行 / 编译产物
*.zip    binary
*.gz     binary
*.tgz    binary
*.tar    binary
*.whl    binary
*.exe    binary
*.dll    binary
*.so     binary
*.dylib  binary
*.pyd    binary
*.lib    binary
*.o      binary
*.a      binary
*.obj    binary
*.pyc    binary
*.pyo    binary
*.olean  binary
*.ltar   binary
*.sqlite binary
*.db     binary
# 模型权重
*.pth    binary
*.pt     binary
*.onnx   binary
*.safetensors binary
*.ckpt   binary
# 音视频
*.mp3    binary
*.mp4    binary
*.wav    binary

# ---- 冻结件：按**字节** sha256 冻结，Git 一旦替它换行哈希就变 ----------------
# tests/ 是"本机门"、不随仓库交付（`.gitignore` 有 `/agentflow/tests/`），
# 但开发者本机把它们重新 add 回来时，这两条必须生效，否则 golden 会红一片。
# 注意这是 `binary`（含 `-diff`）：冻结件本就不该用 diff 读，用 sha256 读。
agentflow/tests/golden/**    binary
agentflow/tests/fixtures/**  binary

# ---- 生成物：不让 GitHub 的语种统计把打包后的前端算成主语言 ------------------
agentflow/src/agentflow/web/static/assets/*  linguist-generated=true
